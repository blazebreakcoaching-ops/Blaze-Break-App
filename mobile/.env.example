# Explicit public build configuration. Copy to mobile/.env for LOCAL dev
# or set values in the intended EAS environment. Never commit .env.
# Firebase Web API keys are public app identifiers, NOT service-account keys.
# Staging and production values MUST be different and match the approved
# Firebase project, registered native app IDs and API deployment.
EXPO_PUBLIC_API_BASE_URL=https://your-approved-staging-cloud-run.example.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-staging-project
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-public-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-staging-firebase-app-id
EXPO_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=replace-with-staging-database-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-public-sender-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-staging-bucket
