rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: this wildcard does NOT create a deny-by-default safety net.
    // Firestore evaluates rules with OR semantics - access is granted if
    // ANY matching rule allows it, so an `if false` match can never
    // override the more specific `allow` rules below it; it is inert. The
    // real deny-by-default is Firestore's own behaviour: a path that no
    // rule allows is denied. This block is kept only as an explicit
    // statement of intent - do not rely on it to lock down a collection,
    // and do not assume it catches paths the specific rules below miss.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    
    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isStringWithMax(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }
    
    // Optional string check
    function isOptionalStringWithMax(data, field, maxLen) {
      return !(field in data) || isStringWithMax(data[field], maxLen);
    }

    function checkCreatedAtUnchanged() {
      // On update, createdAt must not change
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    // A. users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
                    request.resource.data.keys().hasOnly(['displayName', 'preferredName', 'timezone', 'country', 'locale', 'createdAt', 'updatedAt', 'shareAnonymizedDataWithOrg']) &&
                    (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'subscriptionLevel', 'organisationId'])) &&
                    request.resource.data.createdAt is string;
      allow update: if isOwner(uid) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'preferredName', 'timezone', 'country', 'locale', 'updatedAt', 'shareAnonymizedDataWithOrg']) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'subscriptionLevel', 'organisationId'])) &&
                    request.resource.data.createdAt == resource.data.createdAt;
      
      // B. users/{uid}/preferences/ui
      match /preferences/ui {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && 
            request.resource.data.keys().hasOnly(['themePreference', 'novaTone', 'greetingEnabled', 'usePreferredName', 'reducedMotion', 'localePreference']);
      }
      
      // C. users/{uid}/preferences/notifications
      match /preferences/notifications {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
            request.resource.data.keys().hasOnly([
              'notificationsEnabled', 'allowedNudgeCategories', 'nudgeFrequency', 
              'maxNudgesPerDay', 'maxNudgesPerWeek', 'quietHoursStart', 
              'quietHoursEnd', 'timezone', 'pauseUntil', 'weekendNudgesEnabled', 
              'preferredNudgeWindow', 'allowMemoryReviewNudges', 
              'allowWeeklyReviewNudges', 'allowCheckInNudges', 
              'allowRecoveryActionNudges', 'privacyMode', 'updatedAt'
            ]);
      }

      // C2. users/{uid}/preferences/fuel_reminders - Recovery Fuel Engine's
      // own hydration/meeting/emotional reminder setup, distinct from the
      // general nudge system above since these are genuinely scheduled
      // (interval timers, real calendar checks) rather than randomly picked.
      match /preferences/fuel_reminders {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
            request.resource.data.keys().hasOnly([
              'hydrationEnabled', 'hydrationIntervalMinutes',
              'meetingEnabled', 'meetingLeadMinutes',
              'emotionalEnabled', 'emotionalIntervalMinutes',
              'updatedAt'
            ]) &&
            (!('hydrationIntervalMinutes' in request.resource.data) || (request.resource.data.hydrationIntervalMinutes is number && request.resource.data.hydrationIntervalMinutes >= 30 && request.resource.data.hydrationIntervalMinutes <= 240)) &&
            (!('emotionalIntervalMinutes' in request.resource.data) || (request.resource.data.emotionalIntervalMinutes is number && request.resource.data.emotionalIntervalMinutes >= 30 && request.resource.data.emotionalIntervalMinutes <= 240)) &&
            (!('meetingLeadMinutes' in request.resource.data) || (request.resource.data.meetingLeadMinutes is number && request.resource.data.meetingLeadMinutes >= 5 && request.resource.data.meetingLeadMinutes <= 60));
      }

      // Sleep & Wind-Down Builder's ritual state (bedtime target, cutoff
      // toggles, tomorrow's parking list, free-write) - previously pure
      // ephemeral React state that reset on every reload.
      match /preferences/sleep_builder {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
            request.resource.data.keys().hasOnly([
              'bedtime', 'caffeineCutoff', 'phoneOff', 'parkingList', 'mentalUnload', 'updatedAt'
            ]) &&
            (!('bedtime' in request.resource.data) || isStringWithMax(request.resource.data.bedtime, 5)) &&
            (!('caffeineCutoff' in request.resource.data) || request.resource.data.caffeineCutoff is bool) &&
            (!('phoneOff' in request.resource.data) || request.resource.data.phoneOff is bool) &&
            (!('mentalUnload' in request.resource.data) || isOptionalStringWithMax(request.resource.data, 'mentalUnload', 1000)) &&
            (!('parkingList' in request.resource.data) || (request.resource.data.parkingList is list && request.resource.data.parkingList.size() <= 30));
      }

      // C3. users/{uid}/preferences/recovery_intelligence - current-state
      // values for the Recovery Intelligence Layer's interactive widgets
      // (social battery, body symptoms, focus shield, return-to-work phase).
      match /preferences/recovery_intelligence {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
            request.resource.data.keys().hasOnly(['bodySymptoms', 'socialBattery', 'isFocusShieldActive', 'rtwPhase', 'meetingLimit', 'updatedAt']) &&
            (!('bodySymptoms' in request.resource.data) || (request.resource.data.bodySymptoms is list && request.resource.data.bodySymptoms.size() <= 20)) &&
            (!('socialBattery' in request.resource.data) || (request.resource.data.socialBattery is number && request.resource.data.socialBattery >= 0 && request.resource.data.socialBattery <= 100)) &&
            (!('rtwPhase' in request.resource.data) || (request.resource.data.rtwPhase is number && request.resource.data.rtwPhase >= 1 && request.resource.data.rtwPhase <= 10)) &&
            (!('meetingLimit' in request.resource.data) || (request.resource.data.meetingLimit is number && request.resource.data.meetingLimit >= 0 && request.resource.data.meetingLimit <= 50));
      }

      // D. users/{uid}/consents/current
      match /consents/current {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
            request.resource.data.keys().hasOnly(['privacyNoticeVersion', 'termsVersion', 'aiPersonalisationEnabled', 'regionContextEnabled', 'preferredNameGreetingEnabled', 'anonymousOrganisationContributionEnabled', 'acceptedAt', 'updatedAt']);
      }
      
      // E. users/{uid}/entitlements/status - the real Free/Premium
      // entitlement record (plan/status/billingSource/dates), plus the
      // pre-existing platform-admin `role` field. Readable by the owner so
      // the client can show its own plan; never client-writable, so tier
      // and role changes can only come from the backend (see
      // entitlements.ts and GET/POST /api/entitlements* in server.ts).
      match /entitlements/status {
        allow read: if isOwner(uid);
        allow write: if false; // Backend/Admin only
      }

      // E2. users/{uid}/usage_counters/{day|month} - per-day AND per-month
      // (doc id 'month-YYYY-MM') capability usage counters (Nova messages,
      // voice minutes, SMS nudges, etc.) backing entitlement fair-use
      // quotas. Deliberately has NO client rule at all (not even read) -
      // Firestore denies any path with no matching rule, so this covers
      // both key shapes automatically; a client that could read or write
      // its own usage counter could watch or reset its own quota.
      // Backend/Admin SDK only.

      // Third-party OAuth integrations (Slack, Jira, Asana, Calendly, Monday.com)
      // integration_tokens holds raw access/refresh tokens — never client-readable,
      // written only by the backend via the Admin SDK (which bypasses these rules).
      match /integration_tokens/{serviceName} {
        allow read, write: if false;
      }

      // security holds the opt-in TOTP 2FA record (AES-256-GCM encrypted
      // secret, hashed single-use recovery codes, failed-attempt/lockout
      // counters) — never client-readable or client-writable, even a
      // redacted "is MFA enabled" read goes through the dedicated
      // GET /api/auth/mfa/status endpoint, never direct Firestore access,
      // so the encrypted secret can never reach the client outside the
      // one-time enrollment response.
      match /security/{docId} {
        allow read, write: if false;
      }
      // integrations holds redacted connection status only (no secrets) — safe to read.
      match /integrations/{serviceName} {
        allow read: if isOwner(uid);
        allow write: if false; // Backend/Admin only
      }

      // live_signals holds real behavioral aggregates (calendar load, Slack
      // message volume) computed for the Explainable Recovery Score. The raw
      // Slack scan state includes conversation IDs and a Slack user ID, which
      // should never reach the client directly — the backend's redacted GET
      // endpoints are the only intended read path, so this stays fully locked.
      match /live_signals/{signalType} {
        allow read, write: if false;
      }

      // diagnostics holds the burnout-quiz archetype baseline (archScores,
      // dimension scores) used to compute the evolving blend. Sensitive
      // personal data — read only via the dedicated /api/signals/blend
      // endpoint, never directly by the client SDK.
      match /diagnostics/{docId} {
        allow read, write: if false;
      }

      // autopilot_actions is an audit trail of real actions Boundary Autopilot
      // took on the user's behalf (messages sent, DND set, etc.) — readable by
      // the owner directly since transparency about "what did this do for me"
      // matters here, but only the backend (Admin SDK) ever writes to it.
      match /autopilot_actions/{actionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // push_subscriptions holds Web Push endpoint/key data (effectively a
      // credential for sending this device a notification) — never client-
      // readable, written only via the dedicated /api/push/subscribe endpoint.
      match /push_subscriptions/{subId} {
        allow read, write: if false;
      }

      // guardian_alerts is the Tier 1 Guardian Support send history
      // (docs/GUARDIAN_SUPPORT_SPEC.md §D.7) — written only by
      // POST /api/guardian/alert via the Admin SDK. Every other
      // server-only collection in this file gets an explicit locked block
      // like this one; this collection previously had none (relying on
      // Firestore's default-deny for unmatched paths, which was already
      // safe but undocumented and inconsistent with this file's own
      // pattern). The owner's own history is readable only through
      // GET /api/guardian/alerts, which returns metadata (contact name,
      // state, timestamp) but never message content — never direct
      // Firestore access, so this stays fully locked.
      match /guardian_alerts/{alertId} {
        allow read, write: if false;
      }

      // guardian_support_events: privacy-preserving analytics for the
      // Guardian Support Invitation (see guardian-support-invitation.ts and
      // docs/GUARDIAN_SUPPORT_INVITATION.md) — written only by
      // POST /api/guardian/support-event via the Admin SDK, which enforces
      // the closed eventType enum server-side. Same fully-locked pattern as
      // guardian_alerts above: no direct client read or write, since
      // nothing here needs client access and every field is already
      // content-free (event type + optional contact/channel reference,
      // never chat content or an inferred state).
      match /guardian_support_events/{eventId} {
        allow read, write: if false;
      }

      // pulse_status is what the scheduled push-notification check reads —
      // no reason for the client to read this back directly since it's a
      // copy of data already computed client-side.
      match /pulse_status/{docId} {
        allow read, write: if false;
      }

      // ---- PHASE 2B COLLECTIONS ----
      
      // A. recovery/fingerprint
      match /recovery/fingerprint {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) 
            && hasOnly(['archetype', 'identifiedAt', 'version', 'source', 'updatedAt'])
            && hasAll(['archetype', 'identifiedAt', 'version', 'source'])
            && request.resource.data.archetype in ['High-Functioning Exhausted', 'Over-Giver', 'Silent Resenter', 'Founder on Fire', 'Manager in the Middle'];
        allow update: if isOwner(uid)
            && hasOnly(['archetype', 'identifiedAt', 'version', 'source', 'updatedAt'])
            && request.resource.data.archetype in ['High-Functioning Exhausted', 'Over-Giver', 'Silent Resenter', 'Founder on Fire', 'Manager in the Middle'];
      }
      
      // B. checkins - previously had no field validation at all (any
      // shape/type was accepted from a signed-in owner). Matches the exact
      // fields ConnectedDailyCheckIn.tsx writes: four 0-10 sliders, an
      // optional note, and a fixed 'user' source.
      match /checkins/{checkinId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'energyLevel', 'focusLevel', 'detachmentLevel', 'stressLoad', 'note', 'source'])
            && hasAll(['createdAt', 'updatedAt', 'energyLevel', 'focusLevel', 'detachmentLevel', 'stressLoad', 'source'])
            && request.resource.data.energyLevel is number && request.resource.data.energyLevel >= 0 && request.resource.data.energyLevel <= 10
            && request.resource.data.focusLevel is number && request.resource.data.focusLevel >= 0 && request.resource.data.focusLevel <= 10
            && request.resource.data.detachmentLevel is number && request.resource.data.detachmentLevel >= 0 && request.resource.data.detachmentLevel <= 10
            && request.resource.data.stressLoad is number && request.resource.data.stressLoad >= 0 && request.resource.data.stressLoad <= 10
            && request.resource.data.source == 'user'
            && isOptionalStringWithMax(request.resource.data, 'note', 500)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // C. energy_budgets
      match /energy_budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'periodType', 'totalCapacity', 'allocatedCapacity', 'remainingCapacity', 'categories', 'note'])
            && hasAll(['createdAt', 'updatedAt', 'periodType', 'totalCapacity', 'allocatedCapacity', 'remainingCapacity', 'categories'])
            && request.resource.data.periodType in ['day', 'week']
            && request.resource.data.totalCapacity >= 0 && request.resource.data.totalCapacity <= 100
            && request.resource.data.allocatedCapacity >= 0 && request.resource.data.allocatedCapacity <= 100
            && request.resource.data.remainingCapacity >= 0 && request.resource.data.remainingCapacity <= 100
            && request.resource.data.categories is list && request.resource.data.categories.size() <= 20
            && isOptionalStringWithMax(request.resource.data, 'note', 300)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // D. mood_pulses
      match /mood_pulses/{entryId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'moodLabel', 'intensity', 'note', 'source'])
            && hasAll(['createdAt', 'updatedAt', 'moodLabel', 'intensity', 'source'])
            && request.resource.data.moodLabel in ['calm', 'tired', 'pressured', 'frustrated', 'hopeful', 'flat', 'focused', 'overwhelmed']
            && request.resource.data.intensity >= 1 && request.resource.data.intensity <= 10
            && request.resource.data.source == 'user'
            && isOptionalStringWithMax(request.resource.data, 'note', 250)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // E. body_checkins
      match /body_checkins/{entryId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'signals', 'note', 'source'])
            && hasAll(['createdAt', 'updatedAt', 'signals', 'source'])
            && request.resource.data.signals is list && request.resource.data.signals.size() <= 10
            && request.resource.data.signals.hasOnly(['jaw_tension', 'shoulder_tension', 'shallow_breathing', 'headache', 'fatigue', 'restlessness', 'stomach_discomfort', 'calm_settled'])
            && request.resource.data.source == 'user'
            && isOptionalStringWithMax(request.resource.data, 'note', 250)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // F. wins
      match /wins/{winId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'title', 'content', 'category', 'sharedToWall'])
            && hasAll(['createdAt', 'updatedAt', 'title', 'content', 'category'])
            && isStringWithMax(request.resource.data.title, 80)
            && isStringWithMax(request.resource.data.content, 300)
            && request.resource.data.category in ['boundary', 'rest', 'clarity', 'courage', 'routine', 'connection', 'recovery_action']
            && (!('sharedToWall' in request.resource.data) || request.resource.data.sharedToWall is bool)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // blame_resets - BLAME Reset Tool completion log (Breathe, Locate,
      // Accept, Manage, Empower). Matches BLAMEResetOverlay.tsx's write.
      match /blame_resets/{resetId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'speed', 'durationSeconds', 'manageChoice', 'source', 'exchangeMode', 'exchangeTurns'])
            && hasAll(['createdAt', 'updatedAt', 'speed', 'durationSeconds', 'source'])
            && request.resource.data.speed in ['mini', 'full']
            // durationSeconds is now real measured elapsed time (Locate+Accept
            // is self-paced, not a fixed 30s/90s constant) - the 1800s ceiling
            // is a generous sanity bound (a capped text exchange, or up to a
            // 15-minute Nova Live voice call, plus the rest of the flow), not
            // a real behavioural limit.
            && request.resource.data.durationSeconds is number && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 1800
            && (!('manageChoice' in request.resource.data) || request.resource.data.manageChoice == null || request.resource.data.manageChoice in ['delete', 'delegate', 'do'])
            && (!('exchangeMode' in request.resource.data) || request.resource.data.exchangeMode == null || request.resource.data.exchangeMode in ['text', 'voice', 'skipped'])
            && (!('exchangeTurns' in request.resource.data) || request.resource.data.exchangeTurns == null || (request.resource.data.exchangeTurns is number && request.resource.data.exchangeTurns >= 0 && request.resource.data.exchangeTurns <= 3))
            && request.resource.data.source == 'user'
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // spark_checks - SPARK Check daily scan (Sleep, Performance, Aches,
      // Reactions, Kindness). Matches ConnectedSparkCheck's write.
      match /spark_checks/{checkId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'sleep', 'performance', 'aches', 'reactions', 'kindness', 'offCount', 'source'])
            && hasAll(['createdAt', 'updatedAt', 'sleep', 'performance', 'aches', 'reactions', 'kindness', 'offCount', 'source'])
            && request.resource.data.sleep is number && request.resource.data.sleep >= 1 && request.resource.data.sleep <= 5
            && request.resource.data.performance is number && request.resource.data.performance >= 1 && request.resource.data.performance <= 5
            && request.resource.data.aches is number && request.resource.data.aches >= 1 && request.resource.data.aches <= 5
            && request.resource.data.reactions is number && request.resource.data.reactions >= 1 && request.resource.data.reactions <= 5
            && request.resource.data.kindness is number && request.resource.data.kindness >= 1 && request.resource.data.kindness <= 5
            && request.resource.data.offCount is number && request.resource.data.offCount >= 0 && request.resource.data.offCount <= 5
            && request.resource.data.source == 'user'
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // G. weekly_reviews
      match /weekly_reviews/{reviewId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'weekStart', 'weekEnd', 'helped', 'drained', 'nextSmallStep', 'gratitude'])
            && hasAll(['createdAt', 'updatedAt', 'weekStart', 'weekEnd', 'helped', 'drained', 'nextSmallStep'])
            && isStringWithMax(request.resource.data.helped, 300)
            && isStringWithMax(request.resource.data.drained, 300)
            && isStringWithMax(request.resource.data.nextSmallStep, 200)
            && isOptionalStringWithMax(request.resource.data, 'gratitude', 200)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // H. boundary_scripts
      match /boundary_scripts/{scriptId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'title', 'scenarioType', 'scriptText', 'status'])
            && hasAll(['createdAt', 'updatedAt', 'title', 'scenarioType', 'scriptText', 'status'])
            && isStringWithMax(request.resource.data.title, 80)
            && isStringWithMax(request.resource.data.scriptText, 500)
            && request.resource.data.scenarioType in ['workload', 'family', 'client', 'manager', 'friend', 'personal']
            && request.resource.data.status in ['draft', 'saved']
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // I. goals
      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'title', 'description', 'status', 'targetDate', 'category'])
            && hasAll(['createdAt', 'updatedAt', 'title', 'status', 'category'])
            && isStringWithMax(request.resource.data.title, 100)
            && isOptionalStringWithMax(request.resource.data, 'description', 300)
            && request.resource.data.status in ['active', 'paused', 'completed']
            && request.resource.data.category in ['sleep', 'boundaries', 'workload', 'nutrition_rhythm', 'movement', 'reflection', 'recovery_time']
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // Weekly Recovery Goal Tracker ("7-Day Recovery Cycle" / System Habit
      // OS) - one document per ISO week (doc id == weekId), fully
      // overwritten by WeeklyGoalTracker.tsx's persist() on every progress
      // change. Had NO rule at all here until now - since Firestore denies
      // by default on a path no rule matches, every read/write to this
      // collection was silently failing in production, making the feature
      // completely non-functional despite looking fully built.
      match /weekly_habit_cycles/{weekId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['weekId', 'startedAt', 'goals'])
            && hasAll(['weekId', 'startedAt', 'goals'])
            && request.resource.data.weekId.matches('^[0-9]{4}-W[0-9]{2}$')
            && isStringWithMax(request.resource.data.startedAt, 40)
            && request.resource.data.goals is list
            && request.resource.data.goals.size() <= 50;
      }

      // Recovery Fuel Engine's daily physiological check-in - previously
      // localStorage-only despite the panel being explicitly labeled
      // "Connected to Nova". Keyed by date so each day naturally has at
      // most one entry, matching the original per-day localStorage key.
      match /recovery_fuel_logs/{dateId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'hasEaten', 'skippedBreakfast', 'caffeineCount', 'caffeineTiming', 'caffeineEmptyStomach', 'hydrationGlasses', 'morningLight', 'alcoholLogged', 'shakyIrritable'])
            && hasAll(['createdAt', 'updatedAt'])
            && (!('caffeineCount' in request.resource.data) || (request.resource.data.caffeineCount is number && request.resource.data.caffeineCount >= 0 && request.resource.data.caffeineCount <= 20))
            && (!('hydrationGlasses' in request.resource.data) || (request.resource.data.hydrationGlasses is number && request.resource.data.hydrationGlasses >= 0 && request.resource.data.hydrationGlasses <= 30))
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }
      
      // J. nova_permissions/current
      //
      // allowNovaMemorySuggestions/allowNovaRememberCoachingPreferences/
      // allowNovaRememberRecoveryPatterns/allowNovaRememberGoals were
      // required here (hasAll) since this app's very first commit, but no
      // client or server code anywhere has ever written them (confirmed by
      // a full-repo audit) - they were placeholders for a granular memory-
      // type consent UI that was never built. Because hasAll required them
      // and nothing supplied them, this doc could NEVER be successfully
      // created by ANY account: both nova-brain.ts's initNovaPermissionsForNewUser
      // (onboarding) and ensureNovaPermissionsExist (existing-account
      // backfill) write to a not-yet-existing doc, which Firestore treats
      // as a create, which always failed this hasAll check, silently
      // (empty catch blocks). Meaning Nova has never actually had this
      // doc, ever, for anyone - server.ts's getNovaContextAndMetadata has
      // always taken its "no permissions doc" branch and returned zero
      // context. Removed as vestigial, matching this session's existing
      // precedent for dead schema fields (see the removed
      // autoAlertEnabled field).
      match /nova_permissions/current {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['allowCheckins', 'allowEnergyBudgets', 'allowMoodPulses', 'allowBodyCheckins', 'allowWins', 'allowWeeklyReviews', 'allowBoundaryScripts', 'allowGoals', 'allowRecoveryDebt', 'allowRecoveryVelocity', 'allowEnergyTrend', 'allowMoodTrend', 'allowCalendarSignals', 'allowFingerprint', 'allowOnboardingProfile', 'allowRecoveryPlanProgress', 'allowDiagnosisProgress', 'allowEnergyCommitments', 'allowStressTriggers', 'allowHabitCycles', 'allowFuelLogs', 'allowFocusSessions', 'allowSomaticResets', 'allowRecoveryAlly', 'allowNovaMemory', 'allowNovaUseSavedMemories', 'updatedAt'])
            && hasAll(['allowCheckins', 'allowEnergyBudgets', 'allowMoodPulses', 'allowBodyCheckins', 'allowWins', 'allowWeeklyReviews', 'allowBoundaryScripts', 'allowGoals', 'allowRecoveryDebt', 'allowRecoveryVelocity', 'allowEnergyTrend', 'allowMoodTrend', 'allowNovaMemory', 'allowNovaUseSavedMemories'])
            && request.resource.data.allowCheckins is bool
            && request.resource.data.allowEnergyBudgets is bool
            && request.resource.data.allowMoodPulses is bool
            && request.resource.data.allowBodyCheckins is bool
            && request.resource.data.allowWins is bool
            && request.resource.data.allowWeeklyReviews is bool
            && request.resource.data.allowBoundaryScripts is bool
            && request.resource.data.allowGoals is bool
            && request.resource.data.allowRecoveryDebt is bool
            && request.resource.data.allowRecoveryVelocity is bool
            && request.resource.data.allowEnergyTrend is bool
            && request.resource.data.allowMoodTrend is bool
            && (!('allowCalendarSignals' in request.resource.data) || request.resource.data.allowCalendarSignals is bool)
            && (!('allowFingerprint' in request.resource.data) || request.resource.data.allowFingerprint is bool)
            && (!('allowOnboardingProfile' in request.resource.data) || request.resource.data.allowOnboardingProfile is bool)
            && (!('allowRecoveryPlanProgress' in request.resource.data) || request.resource.data.allowRecoveryPlanProgress is bool)
            && (!('allowDiagnosisProgress' in request.resource.data) || request.resource.data.allowDiagnosisProgress is bool)
            && (!('allowEnergyCommitments' in request.resource.data) || request.resource.data.allowEnergyCommitments is bool)
            && (!('allowStressTriggers' in request.resource.data) || request.resource.data.allowStressTriggers is bool)
            && (!('allowHabitCycles' in request.resource.data) || request.resource.data.allowHabitCycles is bool)
            && (!('allowFuelLogs' in request.resource.data) || request.resource.data.allowFuelLogs is bool)
            && (!('allowFocusSessions' in request.resource.data) || request.resource.data.allowFocusSessions is bool)
            && (!('allowSomaticResets' in request.resource.data) || request.resource.data.allowSomaticResets is bool)
            && (!('allowRecoveryAlly' in request.resource.data) || request.resource.data.allowRecoveryAlly is bool)
            && request.resource.data.allowNovaMemory is bool
            && request.resource.data.allowNovaUseSavedMemories is bool;
      }

      // K. derived summaries
      match /derived/{summaryId} {
        allow read: if isOwner(uid);
        allow write: if false; // Derived summaries are server-only written
      }

      // Real audit trail for Nova's recommendation guardrail - previously
      // the Trust Centre's "Recommendation Ledger" showed three hardcoded
      // example rows as if they were real audit evidence. Server-write-only
      // so it's a genuine, tamper-resistant record.
      match /recommendation_ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Legal document acceptance records - server-authoritative by
      // design (spec: "acceptance records are server-authoritative").
      // Written only by POST /api/legal/documents/:docType/accept in
      // server.ts (always req.user.uid, never client-supplied), so a
      // user can read their own acceptance history but can never write
      // or forge one, for themselves or anyone else.
      match /legal_acceptances/{docType} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // L. nova_memories
      // Was previously "allow read, write: if isOwner(uid)" with no field
      // validation at all - any owner could write any fields, any values,
      // no size limit, to the one collection that feeds directly into
      // Nova's AI context and the search/write tools. Tightened to match
      // the exact, real schema nova-brain.ts's persistMemory always
      // writes (verified directly against that function - it sends
      // exactly these 7 fields, every time, no conditional variation).
      // 'verified' remains a valid confidence level here even though the
      // server-side remember_about_user tool refuses to write it - this
      // collection also holds genuinely deterministic writes (e.g. the
      // Safety Engine's rule-based memories), which legitimately can
      // claim that level; the tool-specific restriction lives in
      // application code, not here, since it's about what one particular
      // caller is allowed to claim, not what the collection can hold.
      match /nova_memories/{memoryId} {
        allow read: if isOwner(uid);
        // canEdit:false marks a system-derived record (e.g. Safety Engine
        // memories) the UI deliberately won't offer a delete button for -
        // this must hold that same line at the data layer too, or it's not
        // a real protection, just a UI suggestion bypassable from the
        // console or any other direct Firestore client.
        allow delete: if isOwner(uid) && resource.data.canEdit == true;
        allow create, update: if isOwner(uid)
            && hasOnly(['type', 'content', 'source', 'confidence', 'createdAt', 'updatedAt', 'canEdit'])
            && hasAll(['type', 'content', 'source', 'confidence', 'createdAt', 'updatedAt', 'canEdit'])
            && request.resource.data.type in ['profile', 'trigger', 'state', 'rule', 'preference']
            && isStringWithMax(request.resource.data.content, 1000)
            && isStringWithMax(request.resource.data.source, 200)
            && request.resource.data.confidence in ['low', 'medium', 'high', 'verified']
            && request.resource.data.canEdit is bool;
      }

      // M. nudge_history
      match /nudge_history/{nudgeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
            hasOnly(['category', 'message', 'createdAt', 'shownAt', 'dismissedAt', 'actionTakenAt', 'status', 'reasonCategory', 'source', 'expiresAt', 'updatedAt']) &&
            request.resource.data.category in ['check_in_reminder', 'recovery_action_reminder', 'energy_budget_reflection', 'boundary_practice_reminder', 'weekly_review_reminder', 'memory_review_reminder', 'goal_follow_up', 'climate_survey_reminder', 'fuel_pattern_reminder'] &&
            request.resource.data.source == 'in_app_nova' &&
            request.resource.data.status in ['shown', 'dismissed', 'acted_on'];
      }

      // N. energy_commitments (EnergyBudgetMatrix widget's task list)
      match /energy_commitments/{commitmentId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'name', 'energyDrain', 'type', 'status'])
            && hasAll(['createdAt', 'updatedAt', 'name', 'energyDrain', 'type', 'status'])
            && isStringWithMax(request.resource.data.name, 100)
            && request.resource.data.energyDrain is number && request.resource.data.energyDrain >= 0 && request.resource.data.energyDrain <= 100
            && request.resource.data.type in ['professional', 'social', 'emotional', 'logistical']
            && request.resource.data.status in ['active', 'dropped', 'delegated', 'restructured']
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // O. energy_credits (EnergyBudgetTool page's task list)
      match /energy_credits/{creditId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'task', 'cost', 'priority', 'type', 'shipStage', 'action'])
            && hasAll(['createdAt', 'updatedAt', 'task', 'cost', 'priority', 'type'])
            && isStringWithMax(request.resource.data.task, 100)
            && request.resource.data.cost is number && request.resource.data.cost >= 0 && request.resource.data.cost <= 100
            && request.resource.data.priority in ['High', 'Medium', 'Low']
            && request.resource.data.type in ['Executive', 'Emotional', 'Physical', 'Social']
            && (!('shipStage' in request.resource.data) || request.resource.data.shipStage in ['Safety', 'Habits', 'Identity', 'Purpose'])
            && (!('action' in request.resource.data) || request.resource.data.action in ['keep', 'delegate', 'defer'])
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // P. energy_credits_settings/current (the daily/total budget number for EnergyBudgetTool)
      match /energy_credits_settings/current {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
            && hasOnly(['budget', 'updatedAt'])
            && request.resource.data.budget is number && request.resource.data.budget >= 0 && request.resource.data.budget <= 200;
      }

      // Q. stress_triggers (the "Quick Note" floating trigger logger)
      match /stress_triggers/{triggerId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'text', 'date', 'severity', 'energyLevel'])
            && hasAll(['createdAt', 'updatedAt', 'text', 'date', 'severity', 'energyLevel'])
            && isStringWithMax(request.resource.data.text, 300)
            && request.resource.data.severity is number && request.resource.data.severity >= 1 && request.resource.data.severity <= 10
            && request.resource.data.energyLevel is number && request.resource.data.energyLevel >= 0 && request.resource.data.energyLevel <= 100
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // R. emotional_patterns (free-form word/intensity mood log used by
      // Reflect's 30-day pattern chart - distinct from mood_pulses' fixed
      // moodLabel enum, since this tracks arbitrary self-described words for
      // word-frequency analysis)
      match /emotional_patterns/{entryId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'word', 'intensity', 'category'])
            && hasAll(['createdAt', 'updatedAt', 'word', 'intensity', 'category'])
            && isStringWithMax(request.resource.data.word, 40)
            && request.resource.data.intensity is number && request.resource.data.intensity >= 1 && request.resource.data.intensity <= 10
            && request.resource.data.category in ['negative', 'positive', 'neutral']
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // S. climate_survey_responses (the real HSE-aligned team climate
      // survey - individual responses, read only by the owner. Aggregation
      // for org admins happens server-side via the Admin SDK, same as
      // mood_pulses/body_checkins, never by giving an admin direct read
      // access to this subcollection.)
      match /climate_survey_responses/{responseId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'demands', 'control', 'support', 'relationships', 'role', 'change'])
            && hasAll(['createdAt', 'updatedAt', 'demands', 'control', 'support', 'relationships', 'role', 'change'])
            && request.resource.data.demands is number && request.resource.data.demands >= 1 && request.resource.data.demands <= 5
            && request.resource.data.control is number && request.resource.data.control >= 1 && request.resource.data.control <= 5
            && request.resource.data.support is number && request.resource.data.support >= 1 && request.resource.data.support <= 5
            && request.resource.data.relationships is number && request.resource.data.relationships >= 1 && request.resource.data.relationships <= 5
            && request.resource.data.role is number && request.resource.data.role >= 1 && request.resource.data.role <= 5
            && request.resource.data.change is number && request.resource.data.change >= 1 && request.resource.data.change <= 5
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // T. Recovery Ally - a real, two-sided accountability system. The
      // owner manages their own state/goals directly; personal encouragement
      // messages from the ally themselves are server-only writes (via a
      // token-based public endpoint using the Admin SDK), so a user can
      // never fabricate a message and attribute it to their own ally.
      match /recovery_ally/state {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['isInvited', 'allyName', 'allyEmail', 'permissions', 'shareToken', 'invitedAt', 'updatedAt'])
            && (!('allyEmail' in request.resource.data) || isStringWithMax(request.resource.data.allyEmail, 200))
            && (!('allyName' in request.resource.data) || isStringWithMax(request.resource.data.allyName, 100));
      }

      // Recurring accountability nudges sent to a user's chosen support
      // contact via SMS/WhatsApp. lastSentAt is deliberately excluded from
      // what the client can write - only the server-side scheduler sets it,
      // so a client can't spoof "already sent" and can't fake a send history.
      match /nudge_schedules/{scheduleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['contactId', 'contactName', 'contactMethod', 'notificationPreference', 'message', 'frequency', 'daysOfWeek', 'time', 'timezone', 'enabled', 'contactAcknowledged', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(['contactId', 'contactMethod', 'message', 'frequency', 'time', 'timezone', 'enabled', 'contactAcknowledged', 'createdAt', 'updatedAt'])
            && isStringWithMax(request.resource.data.message, 300)
            && request.resource.data.contactMethod is string && request.resource.data.contactMethod.size() >= 8 && request.resource.data.contactMethod.size() <= 16
            && request.resource.data.frequency in ['daily', 'weekly']
            && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && isStringWithMax(request.resource.data.timezone, 60)
            && request.resource.data.enabled is bool
            && request.resource.data.contactAcknowledged is bool
            && (!('daysOfWeek' in request.resource.data) || (request.resource.data.daysOfWeek is list && request.resource.data.daysOfWeek.size() <= 7))
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      match /ally_shared_goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'text', 'category', 'completedDates'])
            && hasAll(['createdAt', 'updatedAt', 'text', 'category'])
            && isStringWithMax(request.resource.data.text, 200)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      match /ally_encouragements/{id} {
        allow read, delete: if isOwner(uid);
        // Only system-generated (client-computed milestone) messages can be
        // written by the owner. Personal messages - the actual point of
        // this feature - only ever arrive via the server endpoint below.
        allow create: if isOwner(uid)
            && hasOnly(['createdAt', 'type', 'message'])
            && request.resource.data.type == 'system'
            && isStringWithMax(request.resource.data.message, 300);
        allow update: if false;
      }

      // U. voice_journal_entries (Daily Voice Journal - Gemini transcribes
      // and analyzes the memo server-side; the client only ever writes back
      // the exact response it received, never edits transcription/analysis).
      match /voice_journal_entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['createdAt', 'date', 'transcription', 'themes', 'analysis', 'advice', 'emotionalTone'])
            && hasAll(['createdAt', 'date', 'transcription', 'themes', 'analysis', 'advice', 'emotionalTone'])
            && isStringWithMax(request.resource.data.transcription, 4000)
            && isStringWithMax(request.resource.data.analysis, 1000)
            && isStringWithMax(request.resource.data.advice, 500)
            && isStringWithMax(request.resource.data.emotionalTone, 100);
        allow update: if false;
      }

      // Resentment Tracker's raw venting log + Nova's structured analysis of
      // it - equally sensitive personal content, same owner-only pattern.
      match /resentment_logs/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'log', 'yesMeantNo', 'unclear', 'unappreciated', 'missingBoundary'])
            && hasAll(['createdAt', 'updatedAt', 'log'])
            && isStringWithMax(request.resource.data.log, 3000)
            && (!('yesMeantNo' in request.resource.data) || isStringWithMax(request.resource.data.yesMeantNo, 500))
            && (!('unclear' in request.resource.data) || isStringWithMax(request.resource.data.unclear, 500))
            && (!('unappreciated' in request.resource.data) || isStringWithMax(request.resource.data.unappreciated, 500))
            && (!('missingBoundary' in request.resource.data) || isStringWithMax(request.resource.data.missingBoundary, 300))
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // V. diagnosis_progress - completed recovery actions, committed
      // boundary scripts, and written reflections, keyed per burnout
      // profile since retaking with a different profile gets its own
      // tracked progress.
      match /diagnosis_progress/{profileId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['completedActions', 'committedBoundaries', 'allActionIds', 'allBoundaryIds', 'reflections', 'awardedReflections', 'updatedAt'])
            && (!('completedActions' in request.resource.data) || request.resource.data.completedActions is list)
            && (!('committedBoundaries' in request.resource.data) || request.resource.data.committedBoundaries is list)
            // allActionIds/allBoundaryIds: same "was missing from hasOnly,
            // so every write silently failed" bug as recovery_plan_progress
            // above - DiagnoseSection.tsx has written these since
            // GET /api/user/resume-prompt needed them.
            && (!('allActionIds' in request.resource.data) || request.resource.data.allActionIds is list)
            && (!('allBoundaryIds' in request.resource.data) || request.resource.data.allBoundaryIds is list)
            && (!('awardedReflections' in request.resource.data) || request.resource.data.awardedReflections is list)
            && (!('reflections' in request.resource.data) || request.resource.data.reflections is map);
      }

      // W. recovery_plan_progress/state
      match /recovery_plan_progress/state {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['completedIds', 'allActionIds', 'submittedJournals', 'nickname', 'leaderboardOptIn', 'updatedAt'])
            && (!('completedIds' in request.resource.data) || request.resource.data.completedIds is list)
            // allActionIds: the full set of this plan's action ids, written
            // once when the plan is built - RecoveryPlan.tsx has written this
            // alongside completedIds since GET /api/user/resume-prompt needed
            // it to compute "N remaining", but it was missing from this list
            // (hasOnly rejects any field not named here), so every one of
            // those writes was silently failing and the resume-prompt was
            // permanently dead.
            && (!('allActionIds' in request.resource.data) || request.resource.data.allActionIds is list)
            && (!('submittedJournals' in request.resource.data) || (request.resource.data.submittedJournals is list && request.resource.data.submittedJournals.size() <= 100))
            && (!('nickname' in request.resource.data) || isStringWithMax(request.resource.data.nickname, 40))
            && (!('leaderboardOptIn' in request.resource.data) || request.resource.data.leaderboardOptIn is bool);
      }

      // X. workload_reality_check/state
      match /workload_reality_check/state {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['answers', 'completed', 'tasks', 'updatedAt'])
            && (!('answers' in request.resource.data) || request.resource.data.answers is map)
            && (!('completed' in request.resource.data) || request.resource.data.completed is bool)
            && (!('tasks' in request.resource.data) || (request.resource.data.tasks is list && request.resource.data.tasks.size() <= 100));
      }

      // Y. focus_sessions
      match /focus_sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'durationMinutes', 'completed', 'stage'])
            && hasAll(['createdAt', 'updatedAt', 'durationMinutes', 'completed'])
            && request.resource.data.durationMinutes is number
            && request.resource.data.completed is bool
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // Z. support_circle - Guardian contacts. A real, dedicated collection
      // rather than living only in local component state, since this is
      // safety-relevant data.
      match /support_circle/{contactId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'name', 'role', 'isGuardian', 'contactMethod', 'relation', 'notificationPreference'])
            && hasAll(['createdAt', 'updatedAt', 'name', 'role', 'isGuardian', 'contactMethod'])
            && isStringWithMax(request.resource.data.name, 100)
            && isStringWithMax(request.resource.data.contactMethod, 100)
            && request.resource.data.role in ['primary_guardian', 'backup_guardian', 'coach', 'peer']
            && request.resource.data.isGuardian is bool
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AA. user_stats/core - points, streak, badges, debts, profile,
      // support circle, and the burnout fingerprint. Client-writable (unlike
      // derived/stats, which is server-only) since these are earned/edited
      // directly through normal app use, not server-computed aggregates.
      //
      // profile.subscription is explicitly blocked below: it used to be
      // read as the account's Premium/tier signal (src/App.tsx), which
      // meant a client could grant itself Premium with a raw Firestore
      // write - Firestore rules never validated it beyond "profile is a
      // map". The real, server-authoritative tier now lives in the locked
      // users/{uid}/entitlements/status doc (allow write: if false, see
      // below) via entitlements.ts; this field is never read for
      // authorization again, and no client write may set it, so an old or
      // forged value here can't mislead anything. See
      // docs/FREE_PREMIUM_ENTITLEMENTS.md.
      match /user_stats/core {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'points', 'streak', 'rehearsalCount', 'lastEngagementDate',
              'unlockedBadges', 'supportCircle', 'committedActionIds',
              'weeklyGoalsComplete', 'level', 'profile', 'debts',
              'recoveryScore', 'fingerprint', 'lastSeenChangelogVersion', 'updatedAt',
              'shipJourneyLastCommittedAt'
            ])
            // Stamped only when a SHIP Journey quest is actually committed
            // (see handleCommitAction in App.tsx) - deliberately separate
            // from the generic `updatedAt` above, which touches on every
            // stats change and so can't tell the resume-prompt route in
            // server.ts when SHIP Journey specifically was last worked on.
            && (!('shipJourneyLastCommittedAt' in request.resource.data) || isStringWithMax(request.resource.data.shipJourneyLastCommittedAt, 40))
            && (!('lastSeenChangelogVersion' in request.resource.data) || isStringWithMax(request.resource.data.lastSeenChangelogVersion, 100))
            && (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0))
            && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0))
            && (!('unlockedBadges' in request.resource.data) || (request.resource.data.unlockedBadges is list && request.resource.data.unlockedBadges.size() <= 50))
            && (!('committedActionIds' in request.resource.data) || (request.resource.data.committedActionIds is list && request.resource.data.committedActionIds.size() <= 500))
            && (!('supportCircle' in request.resource.data) || (request.resource.data.supportCircle is list && request.resource.data.supportCircle.size() <= 20))
            && (!('debts' in request.resource.data) || (request.resource.data.debts is list && request.resource.data.debts.size() <= 20))
            && (!('profile' in request.resource.data) || (request.resource.data.profile is map && !('subscription' in request.resource.data.profile)
                  // questioningStyle changes HOW Nova asks/writes, never
                  // WHO she is or WHAT she says beyond tone - it must stay
                  // a closed enum a client picks from, never freeform text,
                  // since the server folds this value straight into
                  // Nova's own prompt (see buildNovaQuestioningStyleModule
                  // in server.ts). A raw string here would be a direct
                  // prompt-injection path into Nova's own instructions.
                  && (!('questioningStyle' in request.resource.data.profile)
                      || request.resource.data.profile.questioningStyle == null
                      || request.resource.data.profile.questioningStyle in ['operator', 'board_member', 'mentor', 'pre_mortem'])))
            && (!('fingerprint' in request.resource.data) || request.resource.data.fingerprint is map || request.resource.data.fingerprint == null);
      }

      // AB. micro_recovery/latest - the most recently completed micro-recovery
      // session, read back into Nova's context so a completed reset is
      // actually visible to future conversations.
      match /micro_recovery/latest {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['duration', 'time', 'description', 'details', 'completedAt'])
            && isStringWithMax(request.resource.data.description, 300)
            && request.resource.data.details is list && request.resource.data.details.size() <= 20;
      }

      // AC. somatic_reset_sessions - completed 60s somatic reset sessions.
      match /somatic_reset_sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['createdAt', 'updatedAt', 'durationSeconds'])
            && hasAll(['createdAt', 'updatedAt', 'durationSeconds'])
            && request.resource.data.durationSeconds is number
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AD. nova_feedback - star rating + optional text from the weekly
      // Nova Coach Pulse modal. Write-once from the client; no update since
      // submitted feedback isn't meant to be edited after the fact.
      match /nova_feedback/{feedbackId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['rating', 'feedbackText', 'createdAt'])
            && hasAll(['rating', 'createdAt'])
            && request.resource.data.rating is number
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && (!('feedbackText' in request.resource.data) || request.resource.data.feedbackText == null || isStringWithMax(request.resource.data.feedbackText, 1000));
      }

      // AE. grounding_sessions - Faith & Values Grounding's 5-stage
      // journey (Arrive/Separate/Reflect/Release/Reconnect). Written
      // directly by the client, same as every other reflection-style
      // collection above (recovery_fuel_logs, boundary_scripts) - only
      // the AI-generated Stage 3 reflection text itself goes through a
      // server route (POST /api/grounding/reflect), since that's the only
      // part that needs the Gemini API key and quota enforcement. Pattern
      // detection (detectGroundingPatterns in grounding-content.ts) is
      // recomputed client-side from these session docs on the fly rather
      // than persisted, so there's no separate derived-pattern data to
      // keep in sync or leak. reflectionAnswers is deliberately capped
      // small (at most 2 question/answer pairs per session by the app's
      // own flow) to keep free-text storage minimal, per the feature's
      // explicit "minimise unnecessary sensitive free-text" requirement.
      match /grounding_sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['lens', 'burdenIds', 'customBurden', 'intensity', 'controllableItems', 'uncontrollableItems', 'islamicThemeId', 'reflectionAnswers', 'detectedThemes', 'nextAction', 'sessionDepth', 'capacityState', 'createdAt', 'updatedAt'])
            && hasAll(['lens', 'createdAt', 'updatedAt'])
            && request.resource.data.lens in ['secular', 'values', 'faith', 'islamic']
            && (!('burdenIds' in request.resource.data) || (request.resource.data.burdenIds is list && request.resource.data.burdenIds.size() <= 10))
            && isOptionalStringWithMax(request.resource.data, 'customBurden', 80)
            && (!('intensity' in request.resource.data) || (request.resource.data.intensity is number && request.resource.data.intensity >= 1 && request.resource.data.intensity <= 5))
            && (!('controllableItems' in request.resource.data) || (request.resource.data.controllableItems is list && request.resource.data.controllableItems.size() <= 12))
            && (!('uncontrollableItems' in request.resource.data) || (request.resource.data.uncontrollableItems is list && request.resource.data.uncontrollableItems.size() <= 12))
            && (!('islamicThemeId' in request.resource.data) || request.resource.data.islamicThemeId in ['tawakkul', 'sabr', 'shukr', 'qadr', 'rahmah', 'salah', 'dua', 'ummah', 'niyyah', 'ihsan'])
            && (!('reflectionAnswers' in request.resource.data) || (request.resource.data.reflectionAnswers is list && request.resource.data.reflectionAnswers.size() <= 4))
            // Phase 2's Nova Pattern Engine tags each session with up to 5
            // themes from the fixed taxonomy (grounding-patterns-taxonomy.ts).
            // The server route that generates these already validates them
            // against the same allowlist before ever returning them to the
            // client (see GroundingReflectResponseSchema) - this is shallow
            // defense-in-depth, matching this file's existing convention for
            // other list fields (weekly_habit_cycles.goals, workload_reality_
            // check.tasks) rather than spelling out a 27-item enum here too.
            && (!('detectedThemes' in request.resource.data) || (request.resource.data.detectedThemes is list && request.resource.data.detectedThemes.size() <= 5))
            // Phase 2's Reconnect upgrade (section 17) replaces the four
            // Phase 1 options with six new ones; the four legacy values stay
            // valid here too so already-written sessions remain readable/
            // re-saveable rather than breaking on old data.
            && (!('nextAction' in request.resource.data) || request.resource.data.nextAction in ['nova', 'trusted_person', 'practical_action', 'rest', 'sit_with_this', 'next_step', 'continue_with_nova', 'community', 'return_to_blaze_break'])
            // Phase 3's session depths (section 1) - absent means a
            // pre-Phase-3 session, treated as 'ground' (the standard
            // experience) by the client, never re-migrated here.
            && (!('sessionDepth' in request.resource.data) || request.resource.data.sessionDepth in ['reset', 'ground', 'deep'])
            && (!('capacityState' in request.resource.data) || request.resource.data.capacityState in ['running_on_empty', 'low_capacity', 'some_space', 'ready_to_reflect'])
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AF. preferences/grounding - explicit, user-controlled Grounding
      // settings, kept as its own small preferences doc rather than a
      // field on user_stats/core, matching the fuel_reminders/
      // notifications preferences convention. Extended in Phase 2 with
      // the additional consent/visibility toggles section 19 calls for -
      // still one doc, not a new collection, since these are all just
      // more facets of the same "how Grounding behaves for me" settings.
      match /preferences/grounding {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
            && hasOnly(['patternAnalysisEnabled', 'preferredLens', 'communitySuggestionsEnabled', 'monthlyReflectionEnabled', 'patternHistoryVisible', 'updatedAt'])
            && (!('patternAnalysisEnabled' in request.resource.data) || request.resource.data.patternAnalysisEnabled is bool)
            && (!('preferredLens' in request.resource.data) || request.resource.data.preferredLens in ['secular', 'values', 'faith', 'islamic'])
            && (!('communitySuggestionsEnabled' in request.resource.data) || request.resource.data.communitySuggestionsEnabled is bool)
            && (!('monthlyReflectionEnabled' in request.resource.data) || request.resource.data.monthlyReflectionEnabled is bool)
            && (!('patternHistoryVisible' in request.resource.data) || request.resource.data.patternHistoryVisible is bool);
      }

      // AG. reflection_patterns - Phase 2's Nova Pattern Engine. One doc
      // per taxonomy dimension (grounding-patterns-taxonomy.ts) that has
      // ever qualified for a user, holding only derived counters/status -
      // never raw reflection text. Recomputed by the client from
      // grounding_sessions' detectedThemes after each session; this is the
      // "derived pattern data" section 20 requires get removed when
      // pattern history is cleared.
      match /reflection_patterns/{patternId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['patternKey', 'category', 'firstSeenAt', 'lastSeenAt', 'occurrenceCount', 'status', 'userFeedback', 'userFeedbackNote', 'lensAssociations', 'relatedValues', 'helpfulApproaches', 'paused', 'suppressed', 'resolved', 'resolvedAtOccurrenceCount', 'createdAt', 'updatedAt'])
            && hasAll(['patternKey', 'category', 'firstSeenAt', 'lastSeenAt', 'occurrenceCount', 'status', 'createdAt', 'updatedAt'])
            && request.resource.data.patternKey in ['control', 'uncertainty', 'over_responsibility', 'perfectionism', 'guilt_about_rest', 'boundary_difficulty', 'fear_of_disappointing', 'people_pleasing', 'isolation', 'reluctance_to_ask_for_support', 'excessive_self_expectation', 'work_identity', 'financial_pressure', 'family_responsibility', 'conflict_avoidance', 'overcommitment', 'comparison', 'self_criticism', 'difficulty_accepting_unfinished_work', 'difficulty_accepting_outcomes', 'gratitude', 'patience', 'trust', 'compassion', 'connection', 'purpose', 'values_conflict']
            && request.resource.data.category in ['control_responsibility', 'self_expectation', 'boundaries_people', 'connection_support', 'rest_guilt', 'practical_pressures', 'uncertainty_acceptance', 'values_meaning']
            && request.resource.data.occurrenceCount is number && request.resource.data.occurrenceCount >= 0
            && request.resource.data.status in ['emerging', 'recurring', 'established']
            && (!('userFeedback' in request.resource.data) || request.resource.data.userFeedback == null || request.resource.data.userFeedback in ['resonates', 'not_really'])
            && isOptionalStringWithMax(request.resource.data, 'userFeedbackNote', 200)
            && (!('lensAssociations' in request.resource.data) || (request.resource.data.lensAssociations is list && request.resource.data.lensAssociations.size() <= 4))
            && (!('relatedValues' in request.resource.data) || (request.resource.data.relatedValues is list && request.resource.data.relatedValues.size() <= 10))
            && (!('helpfulApproaches' in request.resource.data) || (request.resource.data.helpfulApproaches is list && request.resource.data.helpfulApproaches.size() <= 10))
            && (!('paused' in request.resource.data) || request.resource.data.paused is bool)
            && (!('suppressed' in request.resource.data) || request.resource.data.suppressed is bool)
            // Phase 3's theme resolution (section 15/16): the person can
            // mark a quiet/dormant pattern as "something I've moved
            // through" - resolvedAtOccurrenceCount snapshots the count at
            // that moment, so a later occurrenceCount increase (a
            // returning theme) can be told apart from "still resolved"
            // without a separate history read.
            && (!('resolved' in request.resource.data) || request.resource.data.resolved is bool)
            && (!('resolvedAtOccurrenceCount' in request.resource.data) || (request.resource.data.resolvedAtOccurrenceCount is number && request.resource.data.resolvedAtOccurrenceCount >= 0))
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AH. aligned_actions - the Values Bridge's "next aligned action",
      // gently followed up on in a later session (never nagged - see
      // FaithValuesMode.tsx's follow-up logic for the recency/dismissal
      // rules that live in application code, not here).
      match /aligned_actions/{actionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['chosenValue', 'nextAlignedAction', 'patternKey', 'followUpStatus', 'followedUpAt', 'createdAt', 'updatedAt'])
            && hasAll(['chosenValue', 'nextAlignedAction', 'createdAt', 'updatedAt'])
            && isStringWithMax(request.resource.data.chosenValue, 40)
            && isStringWithMax(request.resource.data.nextAlignedAction, 200)
            && (!('patternKey' in request.resource.data) || request.resource.data.patternKey in ['control', 'uncertainty', 'over_responsibility', 'perfectionism', 'guilt_about_rest', 'boundary_difficulty', 'fear_of_disappointing', 'people_pleasing', 'isolation', 'reluctance_to_ask_for_support', 'excessive_self_expectation', 'work_identity', 'financial_pressure', 'family_responsibility', 'conflict_avoidance', 'overcommitment', 'comparison', 'self_criticism', 'difficulty_accepting_unfinished_work', 'difficulty_accepting_outcomes', 'gratitude', 'patience', 'trust', 'compassion', 'connection', 'purpose', 'values_conflict'])
            && (!('followUpStatus' in request.resource.data) || request.resource.data.followUpStatus == null || request.resource.data.followUpStatus in ['went_well', 'still_working_on_it', 'didnt_happen'])
            && isOptionalStringWithMax(request.resource.data, 'followedUpAt', 40)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AI. carrying_items - "What am I carrying that isn't mine?", a
      // standalone exercise (section 7) distinct from a full grounding
      // session: one doc per burden the person classified.
      match /carrying_items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['burdenText', 'classification', 'genuinelyMineText', 'notMineText', 'releaseWithoutAbandoningText', 'createdAt', 'updatedAt'])
            && hasAll(['burdenText', 'classification', 'createdAt', 'updatedAt'])
            && isStringWithMax(request.resource.data.burdenText, 80)
            && request.resource.data.classification in ['mine_to_act_on', 'mine_to_influence', 'shared_responsibility', 'outside_control', 'not_sure']
            && isOptionalStringWithMax(request.resource.data, 'genuinelyMineText', 300)
            && isOptionalStringWithMax(request.resource.data, 'notMineText', 300)
            && isOptionalStringWithMax(request.resource.data, 'releaseWithoutAbandoningText', 300)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AJ. grounding_analytics_events - abstract, non-sensitive product
      // events only (section 20): an event NAME plus at most a taxonomy
      // category/lens, never reflection text. Mirrors guardian_support_
      // events' write-once, no-free-text shape.
      match /grounding_analytics_events/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['eventType', 'category', 'lens', 'createdAt'])
            && hasAll(['eventType', 'createdAt'])
            && request.resource.data.eventType in ['grounding_session_completed', 'pattern_explored', 'pattern_feedback_given', 'community_connection_opened', 'carrying_exercise_completed', 'monthly_reflection_viewed', 'aligned_action_created', 'aligned_action_followed_up', 'routine_completed', 'routine_created']
            && (!('category' in request.resource.data) || request.resource.data.category in ['control_responsibility', 'self_expectation', 'boundaries_people', 'connection_support', 'rest_guilt', 'practical_pressures', 'uncertainty_acceptance', 'values_meaning'])
            && (!('lens' in request.resource.data) || request.resource.data.lens in ['secular', 'values', 'faith', 'islamic']);
      }

      // AK. monthly_reflections - Batch 5's optional, user-triggered
      // monthly deep reflection. One doc per calendar month, holding only
      // the structured output. Computed entirely client-side from
      // grounding_sessions/reflection_patterns already in the client's
      // hands (GroundingMonthlyReflection.tsx) - deliberately no AI route,
      // so this feature costs zero extra tokens. MIN_SESSIONS_FOR_MONTHLY_
      // REFLECTION in grounding-patterns-taxonomy.ts gates when the
      // client even offers this.
      match /monthly_reflections/{monthId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['heaviestTheme', 'recurringThemes', 'whatChanged', 'whatHelped', 'carryForwardValue', 'createdAt', 'updatedAt'])
            && hasAll(['createdAt', 'updatedAt'])
            && isOptionalStringWithMax(request.resource.data, 'heaviestTheme', 300)
            && (!('recurringThemes' in request.resource.data) || (request.resource.data.recurringThemes is list && request.resource.data.recurringThemes.size() <= 10))
            && isOptionalStringWithMax(request.resource.data, 'whatChanged', 400)
            && isOptionalStringWithMax(request.resource.data, 'whatHelped', 400)
            && isOptionalStringWithMax(request.resource.data, 'carryForwardValue', 40)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AL. groundingProfile/main - Phase 3's adaptive-grounding personal
      // profile (section 30). Deliberately a single fixed doc id ('main'),
      // not a growing collection - this is one small, derived preference
      // record per person, recomputed/merged by
      // src/lib/grounding-personalisation.ts, never containing raw
      // reflection text.
      match /groundingProfile/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && docId == 'main'
            && hasOnly(['personalisationEnabled', 'useHistoryForPersonalisation', 'followUpOnPreviousActions', 'usePreferredLens', 'voiceGuidanceEnabled', 'preferredSessionDepth', 'commonCapacityState', 'helpfulPromptFamilies', 'unhelpfulPromptFamilies', 'helpfulGroundingThemes', 'preferredLens', 'preferredClosingStyle', 'frequentlySkippedElements', 'updatedAt'])
            && hasAll(['updatedAt'])
            && (!('personalisationEnabled' in request.resource.data) || request.resource.data.personalisationEnabled is bool)
            && (!('useHistoryForPersonalisation' in request.resource.data) || request.resource.data.useHistoryForPersonalisation is bool)
            && (!('followUpOnPreviousActions' in request.resource.data) || request.resource.data.followUpOnPreviousActions is bool)
            && (!('usePreferredLens' in request.resource.data) || request.resource.data.usePreferredLens is bool)
            && (!('voiceGuidanceEnabled' in request.resource.data) || request.resource.data.voiceGuidanceEnabled is bool)
            && (!('preferredSessionDepth' in request.resource.data) || request.resource.data.preferredSessionDepth in ['reset', 'ground', 'deep'])
            && (!('commonCapacityState' in request.resource.data) || request.resource.data.commonCapacityState in ['running_on_empty', 'low_capacity', 'some_space', 'ready_to_reflect'])
            && (!('helpfulPromptFamilies' in request.resource.data) || (request.resource.data.helpfulPromptFamilies is list && request.resource.data.helpfulPromptFamilies.size() <= 27))
            && (!('unhelpfulPromptFamilies' in request.resource.data) || (request.resource.data.unhelpfulPromptFamilies is list && request.resource.data.unhelpfulPromptFamilies.size() <= 27))
            && (!('helpfulGroundingThemes' in request.resource.data) || (request.resource.data.helpfulGroundingThemes is list && request.resource.data.helpfulGroundingThemes.size() <= 20))
            && (!('preferredLens' in request.resource.data) || request.resource.data.preferredLens in ['secular', 'values', 'faith', 'islamic'])
            && (!('preferredClosingStyle' in request.resource.data) || request.resource.data.preferredClosingStyle in ['practical', 'compassionate', 'values', 'faith_friendly', 'islamic'])
            && (!('frequentlySkippedElements' in request.resource.data) || (request.resource.data.frequentlySkippedElements is list && request.resource.data.frequentlySkippedElements.size() <= 20));
      }

      // AM. groundingPromptHistory/{promptId} - question-fatigue tracking
      // (section 5). Doc id is the promptKey itself, so a repeat write is
      // always an update to the same doc rather than an ever-growing log.
      match /groundingPromptHistory/{promptId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['promptKey', 'patternKey', 'lastShownAt', 'timesShown', 'userEngaged', 'userSkipped', 'helpfulRating', 'createdAt', 'updatedAt'])
            && hasAll(['promptKey', 'lastShownAt', 'timesShown', 'createdAt', 'updatedAt'])
            && isStringWithMax(request.resource.data.promptKey, 80)
            && (!('patternKey' in request.resource.data) || request.resource.data.patternKey in ['control', 'uncertainty', 'over_responsibility', 'perfectionism', 'guilt_about_rest', 'boundary_difficulty', 'fear_of_disappointing', 'people_pleasing', 'isolation', 'reluctance_to_ask_for_support', 'excessive_self_expectation', 'work_identity', 'financial_pressure', 'family_responsibility', 'conflict_avoidance', 'overcommitment', 'comparison', 'self_criticism', 'difficulty_accepting_unfinished_work', 'difficulty_accepting_outcomes', 'gratitude', 'patience', 'trust', 'compassion', 'connection', 'purpose', 'values_conflict'])
            && request.resource.data.timesShown is number && request.resource.data.timesShown >= 0
            && (!('userEngaged' in request.resource.data) || (request.resource.data.userEngaged is number && request.resource.data.userEngaged >= 0))
            && (!('userSkipped' in request.resource.data) || (request.resource.data.userSkipped is number && request.resource.data.userSkipped >= 0))
            && (!('helpfulRating' in request.resource.data) || request.resource.data.helpfulRating == null || request.resource.data.helpfulRating in ['helpful', 'not_helpful'])
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AN. groundingFeedback/{feedbackId} - the "What helped?" learning
      // loop (section 6). A closed set of structured outcome labels only -
      // no free-text field beyond one short optional note, so this can
      // never carry raw reflection content either.
      match /groundingFeedback/{feedbackId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['selectedOptions', 'helpfulNote', 'sessionDepth', 'createdAt'])
            && hasAll(['selectedOptions', 'createdAt'])
            && request.resource.data.selectedOptions is list && request.resource.data.selectedOptions.size() <= 8
            && isOptionalStringWithMax(request.resource.data, 'helpfulNote', 200)
            && (!('sessionDepth' in request.resource.data) || request.resource.data.sessionDepth in ['reset', 'ground', 'deep']);
      }

      // AO. groundingRoutines/{routineId} - personal + custom routines
      // (sections 8-9): Morning Grounding, End-of-Day Release, Before/
      // After Something Difficult, or a fully custom one.
      match /groundingRoutines/{routineId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && hasOnly(['name', 'type', 'sessionDepth', 'lens', 'closingStyle', 'preferredPromptKeys', 'reminderEnabled', 'reminderTime', 'reminderDays', 'lastCompletedAt', 'createdAt', 'updatedAt'])
            && hasAll(['name', 'type', 'createdAt', 'updatedAt'])
            && isStringWithMax(request.resource.data.name, 60)
            && request.resource.data.type in ['morning', 'evening', 'before_difficult', 'after_difficult', 'custom']
            && (!('sessionDepth' in request.resource.data) || request.resource.data.sessionDepth in ['reset', 'ground', 'deep'])
            && (!('lens' in request.resource.data) || request.resource.data.lens in ['secular', 'values', 'faith', 'islamic'])
            && (!('closingStyle' in request.resource.data) || request.resource.data.closingStyle in ['practical', 'compassionate', 'values', 'faith_friendly', 'islamic'])
            && (!('preferredPromptKeys' in request.resource.data) || (request.resource.data.preferredPromptKeys is list && request.resource.data.preferredPromptKeys.size() <= 10))
            && (!('reminderEnabled' in request.resource.data) || request.resource.data.reminderEnabled is bool)
            && isOptionalStringWithMax(request.resource.data, 'reminderTime', 10)
            && (!('reminderDays' in request.resource.data) || (request.resource.data.reminderDays is list && request.resource.data.reminderDays.size() <= 7))
            // No push/SMS delivery is wired for routine reminders (section
            // 28's "only if the app already supports reminders" - the
            // existing notification-router.ts is category/frequency-based,
            // not time-of-day precise, so a new scheduler would be needed
            // for that and is out of scope here). reminderEnabled/Time/Days
            // instead drive a gentle in-app "due" card in the Journey view,
            // computed client-side against lastCompletedAt on load.
            && isOptionalStringWithMax(request.resource.data, 'lastCompletedAt', 40)
            && (request.method == 'create' ? true : checkCreatedAtUnchanged());
      }

      // AP. savedReflections/{reflectionId} - "Reflections worth keeping"
      // (section 17) and personal grounding statements (section 18). The
      // user always decides what gets saved here - nothing is
      // automatically labelled profound. isUserCreated distinguishes a
      // person's own words from something they saved out of a session
      // (e.g. a curated Islamic reflection), so the UI never mislabels
      // user-written text as verified religious content.
      match /savedReflections/{reflectionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['type', 'text', 'sourceLens', 'isUserCreated', 'createdAt'])
            && hasAll(['type', 'text', 'isUserCreated', 'createdAt'])
            && request.resource.data.type in ['question', 'insight', 'value', 'aligned_action', 'grounding_statement', 'faith_reflection']
            && isStringWithMax(request.resource.data.text, 400)
            && (!('sourceLens' in request.resource.data) || request.resource.data.sourceLens in ['secular', 'values', 'faith', 'islamic'])
            && request.resource.data.isUserCreated is bool;
      }

      // AQ. movementPreferences/main - Movement Snacks' personal
      // preferences (Foundation batch, section 27). Single fixed doc id,
      // same reasoning as groundingProfile/main - one small preference
      // record, never containing movement history itself.
      match /movementPreferences/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
            && docId == 'main'
            && hasOnly(['favourites', 'seatedPreference', 'audioPreference', 'postMovementFeedbackEnabled', 'preferredAfterWorkCue', 'updatedAt'])
            && hasAll(['updatedAt'])
            && (!('favourites' in request.resource.data) || (request.resource.data.favourites is list && request.resource.data.favourites.size() <= 20))
            && (!('seatedPreference' in request.resource.data) || request.resource.data.seatedPreference is bool)
            && (!('audioPreference' in request.resource.data) || request.resource.data.audioPreference is bool)
            && (!('postMovementFeedbackEnabled' in request.resource.data) || request.resource.data.postMovementFeedbackEnabled is bool)
            && isOptionalStringWithMax(request.resource.data, 'preferredAfterWorkCue', 60);
      }

      // AR. movementHistory/{entryId} - section 18's "avoid repetition"
      // tracking. Deliberately minimal: which movement, whether it was
      // skipped, and the optional structured check-out feedback (section
      // 5) - never reflection text, location, or anything beyond what the
      // recommendation engine and favourites screen need.
      match /movementHistory/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['movementId', 'context', 'skipped', 'feedback', 'createdAt'])
            && hasAll(['movementId', 'skipped', 'createdAt'])
            && isStringWithMax(request.resource.data.movementId, 60)
            && request.resource.data.skipped is bool
            && (!('context' in request.resource.data) || request.resource.data.context in ['sitting_too_long', 'neck_shoulders_tight', 'meeting_lingering', 'switch_off_work', 'need_air_daylight', 'restless_stuck', 'quick'])
            && (!('feedback' in request.resource.data) || request.resource.data.feedback in ['looser', 'more_settled', 'more_awake', 'about_the_same', 'more_uncomfortable']);
      }

      // AS. movement_analytics_events - abstract, non-sensitive product
      // events only (section 28): an event NAME plus at most the movement
      // id/category, never feedback value or free text. Mirrors
      // grounding_analytics_events' write-once, no-free-text shape.
      match /movement_analytics_events/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && hasOnly(['eventType', 'movementId', 'category', 'createdAt'])
            && hasAll(['eventType', 'createdAt'])
            && request.resource.data.eventType in ['movement_started', 'movement_completed', 'movement_skipped', 'movement_feedback_selected']
            && (!('movementId' in request.resource.data) || isStringWithMax(request.resource.data.movementId, 60))
            && (!('category' in request.resource.data) || request.resource.data.category in ['release', 'reset', 'transition', 'energise']);
      }

    }

    // F. public_feature_flags/{featureId}
    match /public_feature_flags/{featureId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User-facing audit trail (privacy/consent actions shown back to the
    // person themselves) - server-write-only so it's a genuine, tamper-
    // resistant record, not something the client could edit or fabricate.
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // GAD-informed anxiety reset events collection. Server-write-only, same
    // shape as audit_logs above - server.ts's POST /api/anxiety-reset is
    // the only legitimate writer (App Check + auth + Zod-validated), and
    // no client code anywhere writes to this collection directly. The
    // previous client-writable rule had no schema validation at all, so a
    // signed-in client could write arbitrary fields/values directly via
    // the Firestore SDK - including a fabricated safetyLevel - bypassing
    // App Check, validation, and the server's point-award logic entirely.
    match /anxiety_reset_events/{eventId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Admin-specific collections
    match /admin_users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if false; // Server-only mutations
    }

    match /admin_audit_logs/{logId} {
      allow read: if isSignedIn() && request.auth.token.admin == true;
      allow write: if false; // Server-only
    }

    match /app_config/{configId} {
      allow read: if isSignedIn() && request.auth.token.admin == true;
      allow write: if false; // Server-only
    }

    // Sign-in IP-velocity tracking for the beforeSignIn Auth Blocking
    // Function (functions/src/index.ts) - written only by that function
    // via the Firebase Admin SDK (a separate deployment from the main
    // Cloud Run app, but Admin SDK either way, so these rules are never
    // consulted for its own writes - this block exists purely so every
    // collection in this file gets an explicit, documented rule rather
    // than relying on unmatched-path default-deny). Never read or
    // written by any client, or even by server.ts.
    match /signin_ip_velocity/{ip} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Legal document registry (Terms, Privacy Notice, etc.) - published
    // only by the admin-only POST /api/admin/legal/:docType/publish
    // route in server.ts (requireAdmin-gated). Public read is required:
    // an anonymous visitor must be able to see Terms/Privacy before
    // they even have an account. Content itself is served through
    // server.ts's GET /api/legal/documents routes rather than read
    // directly by the client SDK, but the rule is written to be
    // correct either way.
    match /legal_documents/{docType} {
      allow read: if true;
      allow write: if false;
      match /versions/{version} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
