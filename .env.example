# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twilio SMS API Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase App Check Validation
# Ensure VITE_RECAPTCHA_ENTERPRISE_SITE_KEY is provided via the AI Studio UI
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
APP_CHECK_DOMAIN=

# Brevo Transactional Email Configuration
BREVO_API_KEY=

# ----------------------------------------------------------------------------
# Web Push (real background notifications, e.g. "your recovery score dropped
# for 2 days" reaching someone even when the app isn't open)
# ----------------------------------------------------------------------------
# Generate your own pair for production with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Never reuse the example values below outside of local testing — the private
# key must stay secret, and a shared key pair would let anyone impersonate
# your push sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@blazebreak.co

# ----------------------------------------------------------------------------
# Third-Party Integrations (OAuth) — Slack, Jira, Asana, Calendly, Monday.com
# ----------------------------------------------------------------------------
# Each requires registering an OAuth app on that provider's own developer portal
# to get a Client ID + Client Secret. Google is NOT here — it's handled by
# Firebase Auth directly (see src/lib/auth.tsx). See docs/INTEGRATIONS_SETUP.md
# for the exact redirect URI and scopes to register with each provider.

# Random long string used to sign the OAuth `state` parameter (CSRF protection).
# Generate one with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Slack: https://api.slack.com/apps -> Create New App -> OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Jira / Atlassian: https://developer.atlassian.com/console/myapps/ -> Create -> OAuth 2.0 integration
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Asana: https://app.asana.com/0/developer-console -> Create new app
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Calendly: https://developer.calendly.com -> create a developer account -> OAuth application
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Monday.com: https://auth.monday.com/oauth2/authorize (developer center) -> Create app
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
