# Google Cloud Run's buildpack-based `gcloud run deploy --source .` runs its
# own `npm install` inside the container build, with no way to pass CLI
# flags to it - so a Dependabot version bump that leaves a peer-dependency
# conflict in package.json (e.g. @eslint/js vs eslint) fails that build
# even though a local `npm ci --legacy-peer-deps` works around it fine.
# This makes every npm invocation - local, CI, and the buildpack's own -
# behave the same way, matching docs/DEPLOY.md's existing guidance to
# always install with --legacy-peer-deps for this repo.
legacy-peer-deps=true
