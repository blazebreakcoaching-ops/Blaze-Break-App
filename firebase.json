{
  "firestore": {
    "database": "ai-studio-67723f85-0bfc-4690-ac83-580d6face1fc",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "*.test.ts", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "firebase-hosting-public",
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "blaze-break",
          "region": "europe-west2"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
